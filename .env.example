# CampusSafe 2026 Environment Configuration

# Express Backend Port (Default: 5000)
PORT=5000

# Backend Base URLs (Optional: when running Next.js full-stack without separate Express backend, leave empty)
NEXT_PUBLIC_SERVER_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Optional: Supabase Integration (Leave empty to use automatic JSON file storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
